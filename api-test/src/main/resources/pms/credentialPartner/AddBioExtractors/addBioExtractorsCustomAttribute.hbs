{
  "id": "mosip.pms.partners.bioextractors.request.post",
  "metadata": {},
  "partnerId": "{{partnerId}}",
  "policyId": "{{policyId}}",
  "request": {
    "partnerPolicyRequestId": "{{partnerPolicyRequestId}}",
    "extractors": [
      {{#each extractors}}
      {
        "attributeName": "{{attributeName}}",
        "biometric": "{{biometric}}",
        {{#if biometricSubTypes}}
        "biometricSubTypes": {{biometricSubTypes}},
        {{/if}}
        "extractorProvider": "{{extractorProvider}}",
        "extractorProviderVersion": "{{extractorProviderVersion}}"
      }{{#unless @last}},{{/unless}}
      {{/each}}
    ]
  },
  "requestTime": "{{requestTime}}",
  "version": "1.0"
}